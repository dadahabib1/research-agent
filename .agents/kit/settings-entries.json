{
 "format": "settings-entries",
 "version": 1,
 "comment": "The kit's entries in .claude/settings.json and .codex/hooks.json (C2 section 4, C5 sections 1 and 4). The install appends each value at its pointer; updates find it by name and old value.",
 "entries": [
  {
   "name": "guard-pre",
   "path": ".claude/settings.json",
   "pointer": "/hooks/PreToolUse",
   "value": {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "args": [
       "-I",
       "${CLAUDE_PROJECT_DIR}/.agents/kit/hooks/guard.py",
       "pre"
      ],
      "timeout": 30,
      "onFailure": "block"
     }
    ]
   }
  },
  {
   "name": "guard-prompt",
   "path": ".claude/settings.json",
   "pointer": "/hooks/UserPromptSubmit",
   "value": {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "args": [
       "-I",
       "${CLAUDE_PROJECT_DIR}/.agents/kit/hooks/guard.py",
       "prompt"
      ],
      "timeout": 30
     }
    ]
   }
  },
  {
   "name": "guard-stop",
   "path": ".claude/settings.json",
   "pointer": "/hooks/Stop",
   "value": {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "args": [
       "-I",
       "${CLAUDE_PROJECT_DIR}/.agents/kit/hooks/guard.py",
       "stop"
      ],
      "timeout": 30
     }
    ]
   }
  },
  {
   "name": "codex-guard-pre",
   "path": ".codex/hooks.json",
   "pointer": "/hooks/PreToolUse",
   "value": {
    "hooks": [
     {
      "type": "command",
      "command": "python -I .agents/kit/hooks/guard.py pre",
      "timeout": 30
     }
    ]
   }
  },
  {
   "name": "codex-guard-post",
   "path": ".codex/hooks.json",
   "pointer": "/hooks/PostToolUse",
   "value": {
    "hooks": [
     {
      "type": "command",
      "command": "python -I .agents/kit/hooks/guard.py post",
      "timeout": 30
     }
    ]
   }
  },
